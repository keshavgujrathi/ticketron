# Server
PORT=4000
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_ORIGIN=http://localhost:4000

# Seat hold configuration
HOLD_TTL_SECONDS=600
WAITLIST_OFFER_TTL_SECONDS=900
RELEASE_VALVE_WINDOW_SECONDS=60
SCHEDULER_INTERVAL_MS=5000

# Email (SMTP). Leave blank to auto-use a free Ethereal test inbox (logs preview URL to console).
# For production: use Gmail app password, SendGrid free tier, Mailtrap, or Resend free tier.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ticketron <no-reply@ticketron.dev>"

# Database
DB_FILE=./data/ticketron.db
